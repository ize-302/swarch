#!/bin/bash
# ~/.local/bin/power-menu
# Power menu in the same corner panel as the app launcher. Pick with arrows +
# Enter or a click. Running it again while open closes it, as do Escape and
# Backspace.
#
# Without arguments it toggles the Quickshell menu
# (~/.config/quickshell/launcher). With an entry (`power-menu reboot`) it carries
# that entry out, which is how the Quickshell menu acts on a choice.
locker=(~/.local/bin/lock-screen)

# The running sway's socket. $SWAYSOCK can't be trusted: long-lived parents
# such as tmux keep the one from an earlier session.
sway_socket="/run/user/$UID/sway-ipc.$UID.$(pgrep -x -u "$UID" sway | head -1).sock"

run() {
	case "$1" in
	lock) "${locker[@]}" ;;
	logout) swaymsg -s "$sway_socket" exit ;;
	sleep) systemctl suspend ;;
	hibernate) "${locker[@]}" && sleep 1 && systemctl hibernate ;;
	reboot) systemctl reboot ;;
	shutdown) systemctl poweroff -i ;;
	esac
}

if [ $# -gt 0 ]; then
	run "$1"
	exit
fi

toggle=(qs -c launcher ipc call power toggle)

"${toggle[@]}" >/dev/null 2>&1 && exit 0

# Not running yet: start it and wait for it to answer
if qs -c launcher -d >/dev/null 2>&1; then
	for _ in {1..20}; do
		"${toggle[@]}" >/dev/null 2>&1 && exit 0
		sleep 0.1
	done
fi

exit 1
