# SwayFX settings

# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys
set $left h
set $down j
set $up k
set $right l

set $term alacritty

set $menu ~/.local/bin/app-menu

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:JetBrainsMono NF Medium 13

animation_duration_ms 250

blur disable
# blur_xray enables wallpaper blurring without blurring windows below
blur_xray disable
blur_passes 3
blur_radius 6
# Grain so the blur reads as frosted glass, not a flat tint. Saturation stays
# at 1: any more and the wallpaper in the gaps glows through the menus
blur_noise 0.06
# blur_brightness <float value 0 - 2>
# blur_contrast <float value 0 - 2>
blur_saturation 1.0

# Frosted glass behind waybar and the launcher's menus and notifications
# (their backgrounds are translucent in style.css / Theme.qml). Independent
# of the window `blur` setting above.
layer_effects "waybar" blur enable; blur_ignore_transparent enable
layer_effects "launcher" blur enable; blur_ignore_transparent enable
# Menus with a small, soft drop shadow (app, power, clipboard and key bindings
# menus). The shadow_* settings only show here: window shadows are off below.
layer_effects "launcher-shadow" blur enable; blur_ignore_transparent enable; shadows enable
shadow_blur_radius 12
shadow_color #00000059
shadow_offset 0 3

corner_radius 0

gaps inner 5

default_border pixel 2
default_floating_border normal
hide_edge_borders smart

# corner radius needs gaps to be visible

# SwayFX also features window drop shadows, which, of course, can be enabled at any time
shadows disable
shadows_on_csd enable

#
# The wallpaper last set (a random one from ~/Pictures/wallpapers at first)
exec_always ~/.local/bin/wallpaper

# A window asking for attention (a link opened in the browser, a chat app
# pinging) gets focused, instead of only turning its workspace red on the bar
focus_on_window_activation focus
exec ~/.local/bin/focus-urgent

# Startup apps: browser on workspace 2, terminal on workspace 1 (left focused).
# Sway places each window on the workspace it was launched from.
exec swaymsg "workspace number 1; exec $term"

# No nm-applet: Wi-Fi is in the launcher's control panel, which also asks
# for a network's password when it's wrong. nm-applet would take those
# requests from NetworkManager and show its own dialog instead.

# blueman-manager auto-starts blueman-applet; stop that applet adding a tray
# icon, since waybar's bluetooth module is the icon. ShowConnected must go
# too: it depends on StatusIcon and would pull it back in.
exec gsettings set org.blueman.general plugin-list "['!StatusIcon', '!ShowConnected']"

# GTK theme. On Wayland GTK3/4 apps read these from gsettings and ignore
# ~/.config/gtk-3.0/settings.ini, so set them here to keep apps dark.
exec_always gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3-dark'
exec_always gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
exec_always gsettings set org.gnome.desktop.interface icon-theme 'Papirus-Dark'

# Clipboard history: store every copy so it survives the source app closing
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

# App launcher, power menu, clipboard menu, scratchpad menu, key bindings
# menu and control panel daemon, toggled by ~/.local/bin/app-menu ($menu),
# ~/.local/bin/power-menu, ~/.local/bin/clipboard-menu,
# ~/.local/bin/scratchpad-menu, ~/.local/bin/keybind-menu,
# ~/.local/bin/control-panel, ~/.local/bin/notification-center and
# ~/.local/bin/date-panel. It also shows the volume popup, the bluetooth pairing prompts,
# the notifications (in place of dunst) and the password prompt apps ask for
# through polkit (saving a Wi-Fi network in nm-connection-editor, mounting a
# disk), as the session's polkit agent.
exec qs -c launcher -d

# Outputs (where each display goes, its scale) are your own settings: they go
# in ~/.config/sway/config.d/ (see the end of this file)

# Turn the laptop screen off/on with the lid
bindswitch --reload --locked lid:on output eDP-1 disable
bindswitch --reload --locked lid:off output eDP-1 enable

#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

### Idle configuration
#
# Lock after 15 minutes idle. The session is also locked before a manual
# suspend (power menu).
exec swayidle -w \
         timeout 900 '~/.local/bin/lock-screen' \
         before-sleep '~/.local/bin/lock-screen'

# Don't go idle while something is fullscreen (video, presentations)
for_window [shell=".*"] inhibit_idle fullscreen

### Input configuration
#
# Example configuration:
#
#   input type:touchpad {
#       dwt enabled
#       tap enabled
#       natural_scroll enabled
#       middle_emulation enabled
#   }
#
#   input type:keyboard {
#       xkb_layout "eu"
#   }
#
# You can also configure each device individually.
# Read `man 5 sway-input` for more information about this section.

input type:touchpad {
    tap enabled
    natural_scroll enabled
}

# Four-finger swipe switches workspace on the current monitor. Directions match
# natural scrolling: swipe left brings in the next workspace, as if dragging it.
bindgesture swipe:4:left workspace next_on_output
bindgesture swipe:4:right workspace prev_on_output

# Login sound
exec paplay /usr/share/sounds/freedesktop/stereo/service-login.oga

# Power menu
bindsym $mod+Escape exec ~/.local/bin/power-menu

# A different random wallpaper
bindsym $mod+Shift+w exec ~/.local/bin/wallpaper --random

# Open a terminal
bindsym $mod+Return exec $term

# Open the file manager
bindsym $mod+e exec thunar

# Screenshot of an area (drag) or a whole screen (click), opened in swappy to
# mark up, save (to ~/Pictures/Screenshots) or copy. Pressing it again while
# picking cancels
bindsym $mod+s exec ~/.local/bin/screenshot

# Start or stop screen recording
bindsym $mod+Shift+s exec ~/.local/bin/record-toggle --desktop

# Move the focused window to the scratchpad
bindsym $mod+BackSpace move scratchpad

# Close the focused window
bindsym $mod+x kill

# Start your launcher
bindsym $mod+space exec $menu

# Clipboard history picker
bindsym $mod+c exec ~/.local/bin/clipboard-menu

# Key bindings cheat sheet
bindsym $mod+F1 exec ~/.local/bin/keybind-menu

# Sound: what's playing, and the output and input volume
bindsym $mod+a exec ~/.local/bin/control-panel

# Notifications
bindsym $mod+Shift+n exec ~/.local/bin/notification-center

# Network/Bluetooth GUIs (swayfx tray can't render dbusmenu popups from nm-applet)

# Network connections
bindsym $mod+n exec nm-connection-editor

# Bluetooth devices
bindsym $mod+Shift+b exec blueman-manager

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod normal

# btop opened from waybar's cpu/memory blocks (~/.local/bin/btop-toggle) gets
# its own workspace
for_window [app_id="btop"] move container to workspace btop, workspace btop

# Reload the configuration file
bindsym $mod+Shift+r reload

# Exit SwayFX
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit SwayFX? This will end your Wayland session.' -B 'Yes, exit SwayFX' 'swaymsg exit'

#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right

    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Workspaces:
#
    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10
    # Note: workspaces can have any name you want, not just numbers.
    # We just use 1-10 as the default.

# Split horizontally
bindsym $mod+b splith

# Split vertically
bindsym $mod+v splitv


# Make the current focus fullscreen
bindsym $mod+f fullscreen

# Toggle between tiling and floating
bindsym $mod+Shift+space floating toggle

#
# Scratchpad:
#
  # SwayFX has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later: $mod+BackSpace
    # parks the focused window ($mod+x closes it).

    # The menu lists the scratchpad windows (waybar shows how many there
    # are). Picking one takes it out and tiles it on the current workspace.
    # A release binding on Super alone only fires when no other key was
    # pressed with it. `nop` runs nothing: the menu daemon hears the binding
    # over sway IPC and opens on the second of two quick taps
    # (config/quickshell/launcher/ScratchpadMenu.qml).

    # Scratchpad windows (double tap Super)
    bindsym --release Super_L nop scratchpad-tap

#
# Resizing containers:
#
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Ditto, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode. Each key has its own comment, which names it
    # in the key bindings cheat sheet.

    # Leave resize mode
    bindsym Return mode "default"

    # Leave resize mode
    bindsym Escape mode "default"

    # Leave resize mode
    bindsym $mod+r mode "default"
}

# Resize mode
bindsym $mod+r mode "resize"
#
# Utilities:
#
    # Special keys to adjust volume. Up stops at 100% (-l 1.0): past that
    # PipeWire boosts the signal in software, which distorts. Each key has
    # its own comment, a blank line apart, which names it in the key
    # bindings cheat sheet.

    # Volume up
    bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 \@DEFAULT_AUDIO_SINK@ 5%+ && paplay /usr/share/sounds/freedesktop/stereo/audio-volume-change.oga

    # Volume down
    bindsym --locked XF86AudioLowerVolume exec wpctl set-volume \@DEFAULT_AUDIO_SINK@ 5%- && paplay /usr/share/sounds/freedesktop/stereo/audio-volume-change.oga

    # Mute
    bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle

    # Mute the microphone
    bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle

    # Special keys to adjust brightness via brightnessctl

    # Brightness down
    bindsym --locked XF86MonBrightnessDown exec brightnessctl --min-val=1 -q set 3%-

    # Brightness up
    bindsym --locked XF86MonBrightnessUp exec brightnessctl -q set 3%+

    # Special keys to control media via playerctl

    # Play or pause
    bindsym --locked XF86AudioPlay exec playerctl play-pause

    # Play or pause
    bindsym --locked XF86AudioPause exec playerctl play-pause

    # Previous track
    bindsym --locked XF86AudioPrev exec playerctl previous

    # Next track
    bindsym --locked XF86AudioNext exec playerctl next

    # Stop playback
    bindsym --locked XF86AudioStop exec playerctl stop

    # Screenshot of the whole screen
    bindsym Print exec grim

#
# Status Bar:
#
# Read `man 5 sway-bar` for more information about this section.
bar {
				swaybar_command waybar
        # position bottom
        # tray_output *
        # icon_theme Papirus-Dark

        colors {
            separator #414868
            background #15161e
            statusline #B1B1B1
            focused_workspace #1a1b26 #9ece6a #1a1b26
            active_workspace #333333 #333333 #888888
            inactive_workspace #1a1b26 #1a1b26 #9ece6a
            urgent_workspace #7dd3fc #7dd3fc #15161e
        }
}


## Colours
set $base00 #282828
set $base01 #fbf1c7
set $base02 #cc241d
set $base03 #FF7518
set $base04 #ffffff

## Window Colours
## class border background text indicator child_border
client.focused   $base04  $base00  $base01  $base02  $base03

include /etc/sway/config.d/*

# Your own settings, after everything above so they can override it:
# outputs (`output DP-2 pos 0 0`), keyboard layout, extra bindings. Not
# part of swarch, so they survive updating it; put them in
# ~/.config/sway/config.d/, e.g. outputs.conf.
include ~/.config/sway/config.d/*
