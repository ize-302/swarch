{
	// Glyphs are written as \u escapes so editors can't mangle Nerd Font codepoints.
	"layer": "top",
	"position": "bottom",
	"height": 32,
	"spacing": 0,
	"modules-left": ["sway/workspaces", "sway/scratchpad", "sway/mode"],
	"modules-center": [
		"temperature",
		"disk",
		"cpu",
		"memory",
		"battery"
	],
	"modules-right": [
		"custom/recording",
		"tray",
		"custom/volume",
		"backlight",
		"custom/pomodoro",
		"network",
		"bluetooth",
		"custom/notifications",
		"custom/clock"
		// "custom/kernel"
	],

	// {windows} adds one icon per open window, picked by app id below
	// (Nerd Font glyphs; anything unlisted gets the generic window icon).
	// Each icon has thin spaces (U+2009) around it, two before and one after, so an empty workspace
	// shows the number alone.
	"sway/workspaces": {
		"disable-scroll": false,
		"all-outputs": false,
		"format": "{name}{windows}",
		"format-window-separator": "",
		"window-rewrite-default": "   ",
		"window-rewrite": {
			"class<Alacritty>": "   ",
			"class<btop>": "   ",
			"class<zen.*|firefox.*|librewolf>": "   ",
			"class<google-chrome.*|chromium.*>": "   ",
			"class<[Tt]hunar>": "   ",
			"class<com.obsproject.Studio>": "   ",
			"class<mpv|vlc>": "   ",
			"class<blueman-manager>": "   ",
			"class<nm-connection-editor>": "   "
		}
	},

	// One dot per window in the scratchpad, hidden while there are none.
	// The icon is picked by window count, so the last one covers 5 and up.
	// Hover lists them; click opens the menu to take one out.
	"sway/scratchpad": {
		"format": "{icon}",
		"format-icons": ["", "\u2022", "\u2022\u2022", "\u2022\u2022\u2022", "\u2022\u2022\u2022\u2022", "\u2022\u2022\u2022\u2022+"],
		"show-empty": false,
		"tooltip-format": "{app}: {title}",
		"on-click": "~/.local/bin/scratchpad-menu"
	},


	// temperature has no `states`, so the colour lives in the icon.
	// Icon index = temp / (critical-threshold / 20) = temp / 5:
	// <50, 50-54, 55-59, 60-64, 65-69, >=70.
	"temperature": {
		"thermal-zone": 0,
		"critical-threshold": 100,
		"interval": 1,
		"format": "{icon} {temperatureC}ºC</span>",
		"format-icons": [
			"<span color='#00FF00'>", "<span color='#00FF00'>",
			"<span color='#00FF00'>", "<span color='#00FF00'>",
			"<span color='#00FF00'>", "<span color='#00FF00'>",
			"<span color='#00FF00'>", "<span color='#00FF00'>",
			"<span color='#00FF00'>", "<span color='#00FF00'>",
			"<span color='#bfff00'>",
			"<span color='#ffff00'>",
			"<span color='#ffbf00'>",
			"<span color='#ff8000'>",
			"<span color='#ff0000'>", "<span color='#ff0000'>",
			"<span color='#ff0000'>", "<span color='#ff0000'>",
			"<span color='#ff0000'>", "<span color='#ff0000'>"
		],
		"tooltip": false
	},

	// Percentage used of the root filesystem. Hover shows used, free and total
	// in GiB (same units as `df -h`).
	// States match on percentage used; style.css colours them.
	"disk": {
		"path": "/",
		"interval": 30,
		"unit": "GiB",
		"format": " {percentage_used}%",
		"states": { "d0": 0, "d50": 50, "d65": 65, "d75": 75, "d85": 85, "d92": 92 },
		"tooltip-format": "Used {specific_used:0.0f}G\nFree {specific_free:0.0f}G\nTotal {specific_total:0.0f}G"
	},

	// Colours come from the state classes in style.css.
	// Click opens btop on its own workspace; click again there to close it.
	"cpu": {
		"interval": 1,
		"format": " {usage}%",
		"states": { "c0": 0, "c10": 10, "c25": 25, "c50": 50, "c60": 60, "c70": 70 },
		"on-click": "~/.local/bin/btop-toggle",
		"tooltip": false
	},

	// Hover shows the actual amounts, in GiB.
	"memory": {
		"interval": 1,
		"format": " {percentage}%",
		"states": { "c0": 0, "c10": 10, "c25": 25, "c50": 50, "c60": 60, "c70": 70 },
		"on-click": "~/.local/bin/btop-toggle",
		"tooltip-format": "RAM {used:0.1f} / {total:0.1f} GiB\nFree {avail:0.1f} GiB\nSwap {swapUsed:0.1f} / {swapTotal:0.1f} GiB"
	},

	// Battery states match when capacity <= value.
	// Time remaining is shown on hover only.
	"battery": {
		"interval": 1,
		"states": { "lt10": 9, "lt30": 29, "lt50": 49, "lt80": 79, "lt100": 99 },
		"format": "{icon} {capacity}%",
		"format-time": "{H}h{M}m",
		"format-icons": {
			"charging": "󰂄",
			"plugged": "󰂄",
			"full": "󰂄",
			"not charging": "󰂄",
			"lt10": "󰁻",
			"lt30": "󰁼",
			"lt50": "󰁾",
			"lt80": "󰂀",
			"default": "󰁹"
		},
		"tooltip-format": "{timeTo}",
		"tooltip-format-discharging": "{time} left",
		"tooltip-format-charging": "{time} until full"
	},

	// The first backlight there is (intel_backlight, amdgpu_bl0, ...)
	"backlight": {
		"format": "󰖨 {percent}%",
		"tooltip": false
	},

	// The speaker glyph and the volume, or a music note while something
	// plays. Quickshell writes it (config/quickshell/launcher/BarVolume.qml),
	// with the level as the class for style.css's colours, and signals
	// SIGRTMIN+10 on a change. Click opens the sound popup (what's playing,
	// output and input, like Super+A), right click toggles mute, scrolling
	// changes the volume like the volume keys.
	"custom/volume": {
		"exec": "cat \"$XDG_RUNTIME_DIR/volume.json\" 2>/dev/null || echo '{\"text\": \"\"}'",
		"return-type": "json",
		"interval": "once",
		"signal": 10,
		"tooltip": false,
		"on-click": "~/.local/bin/control-panel --pointer",
		"on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
		"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
	},

	// A red record dot while the screen is being recorded (Super+Shift+S),
	// hidden otherwise. ~/.local/bin/record-toggle signals SIGRTMIN+12 when
	// it starts and stops. Click stops the recording.
	"custom/recording": {
		"exec": "pgrep -x wf-recorder >/dev/null && echo '{\"text\": \"\\udb81\\udc4a\", \"tooltip\": \"Recording the screen. Click to stop\"}' || echo '{\"text\": \"\"}'",
		"return-type": "json",
		"interval": "once",
		"signal": 12,
		"on-click": "~/.local/bin/record-toggle"
	},

	// The penguin; hover shows the kernel version. The script has to send
	// some text, or waybar hides the module; the format replaces it.
	"custom/kernel": {
		"exec": "printf '{\"text\": \"linux\", \"tooltip\": \"Linux Kernel %s\"}\\n' \"$(uname -r)\"",
		"return-type": "json",
		"interval": "once",
		"format": "🐧"
	},

	// The pomodoro timer's time left, with a timer (focus) or a cup (a
	// break), only while there's one going. Quickshell writes it
	// (config/quickshell/launcher/Pomodoro.qml) and signals SIGRTMIN+11 each
	// second. Click starts or pauses it, right click resets it, middle click
	// skips to the next.
	"custom/pomodoro": {
		"exec": "cat \"$XDG_RUNTIME_DIR/pomodoro.json\" 2>/dev/null || echo '{\"text\": \"\"}'",
		"return-type": "json",
		"interval": "once",
		"signal": 11,
		"on-click": "qs -c launcher ipc call pomodoro toggle",
		"on-click-right": "qs -c launcher ipc call pomodoro reset",
		"on-click-middle": "qs -c launcher ipc call pomodoro skip"
	},

	// A bell, with an orange dot while there are new notifications and a
	// line through it during do not disturb. Quickshell writes it
	// (config/quickshell/launcher/Notifications.qml) and signals SIGRTMIN+8
	// on a change. Click opens the notification centre over it, right click
	// turns do not disturb on or off.
	"custom/notifications": {
		"exec": "cat \"$XDG_RUNTIME_DIR/notifications.json\" 2>/dev/null || echo '{\"text\": \"\"}'",
		"return-type": "json",
		"interval": "once",
		"signal": 8,
		"tooltip": false,
		"on-click": "~/.local/bin/notification-center --pointer",
		"on-click-right": "qs -c launcher ipc call notifications toggleDoNotDisturb"
	},

	"custom/clock": {
		"exec": "~/.local/bin/clock-status",
		"return-type": "json",
		// The time over the date, lined up on the left
		"justify": "left",
		"interval": 10,
		"on-click": "~/.local/bin/date-panel --pointer"
	},

	// Replaces nm-applet's tray icon: signal bars on Wi-Fi, filling in with
	// the strength (0-24, 25-49, 50-74, 75-100%), a cable on ethernet, and
	// the bars struck through when off or disconnected. Hover shows the
	// download and upload speed too, every 2 seconds. Hover
	// shows the network; click opens the control panel's Network page.
	"network": {
		"interval": 2,
		"format-wifi": "{icon}",
		"format-icons": ["\udb82\udcbf", "\udb82\udcbc", "\udb82\udcbd", "\udb82\udcbe"],
		"format-ethernet": "\udb80\ude00",
		"format-linked": "\udb81\udf83",
		"format-disconnected": "\udb81\udf83",
		"format-disabled": "\udb81\udf83",
		"tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}\n\u2193 {bandwidthDownBytes}  \u2191 {bandwidthUpBytes}",
		"tooltip-format-ethernet": "Ethernet\n{ipaddr}\n\u2193 {bandwidthDownBytes}  \u2191 {bandwidthUpBytes}",
		"tooltip-format-disconnected": "Not connected",
		"tooltip-format-disabled": "Wi-Fi off",
		"on-click": "~/.local/bin/control-panel --pointer Network"
	},

	// Replaces blueman-applet. Hover lists connected devices; click opens
	// the control panel's Bluetooth page (its switch turns it on or off,
	// unblocking rfkill if needed), right click opens blueman's manager.
	"bluetooth": {
		"format": "󰂯",
		"format-connected": "󰂱",
		"format-off": "󰂲",
		"format-disabled": "󰂲",
		"format-no-controller": "",
		"tooltip-format": "{controller_alias}: on, no devices connected",
		"tooltip-format-off": "Bluetooth off",
		"tooltip-format-disabled": "Bluetooth disabled",
		"tooltip-format-connected": "{controller_alias}: {num_connections} connected\n{device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias}",
		"tooltip-format-enumerate-connected-battery": "{device_alias}  {device_battery_percentage}%",
		"on-click": "~/.local/bin/control-panel --pointer Bluetooth",
		"on-click-right": "blueman-manager"
	},

	"tray": {
		"icon-size": 21,
		"spacing": 14
	}
}
