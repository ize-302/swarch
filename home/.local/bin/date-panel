#!/bin/bash
# ~/.local/bin/date-panel [--pointer]
# Toggles the Quickshell date panel, the calendar and the pomodoro timer
# (~/.config/quickshell/launcher), starting its daemon first if it isn't
# running. --pointer (from the bar's
# clock) centres it over the clock, rather than at the right edge.
if [ "$1" = "--pointer" ]; then
	toggle=(qs -c launcher ipc call datePanel toggleDatePanelAtPointer)
else
	toggle=(qs -c launcher ipc call datePanel toggleDatePanel)
fi

"${toggle[@]}" >/dev/null 2>&1 && exit 0

# Not running yet: start it and wait for it to answer
if qs -c launcher -d >/dev/null 2>&1; then
	for _ in {1..20}; do
		"${toggle[@]}" >/dev/null 2>&1 && exit 0
		sleep 0.1
	done
fi

exit 1
