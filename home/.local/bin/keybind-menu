#!/bin/bash
# ~/.local/bin/keybind-menu
# Toggles the Quickshell key bindings menu (~/.config/quickshell/launcher),
# starting its daemon first if it isn't running.
toggle=(qs -c launcher ipc call keybinds toggleKeybindMenu)

"${toggle[@]}" >/dev/null 2>&1 && exit 0

# Not running yet: start it and wait for it to answer
if qs -c launcher -d >/dev/null 2>&1; then
	for _ in {1..20}; do
		"${toggle[@]}" >/dev/null 2>&1 && exit 0
		sleep 0.1
	done
fi

exit 1
