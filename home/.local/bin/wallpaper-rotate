#!/bin/bash
# ~/.local/bin/wallpaper-rotate [seconds]
# ~/.local/bin/wallpaper-rotate --next
# Sets a random wallpaper from ~/Pictures/wallpapers on every output, then
# picks a new one every 30 minutes (or the given number of seconds). Runs one
# instance per sway session and stops once that session is gone. Sway drops
# the wallpaper on every reload, so starting it again while it is running puts
# the current image back without restarting the timer.
#
# --next (bound to a key in config/sway/config) has the running instance pick
# a new image now, and the 30 minutes start again from there.
#
# Each image is also copied to /var/lib/sddm-wallpaper/current, which
# install.sh creates for this user, so the login screen (config/sddm/themes/
# custom) can show it: SDDM can't read $HOME.
dir=~/Pictures/wallpapers
share=/var/lib/sddm-wallpaper
next=
if [ "$1" = --next ]; then
	next=1
	shift
fi
interval=${1:-1800}
state="${XDG_RUNTIME_DIR:-/tmp}/wallpaper-rotate.${SWAYSOCK##*/}"

set_bg() {
	swaymsg -q "output * bg \"$1\" fill"
}

# Renamed into place, so the greeter never reads half an image
share_bg() {
	[ -w "$share" ] || return 0
	cp -f -- "$1" "$share/.current.tmp" && mv -f "$share/.current.tmp" "$share/current"
}

exec 9>"$state.lock"
if ! flock -n 9; then
	if [ -n "$next" ]; then
		kill -USR1 "$(<"$state.pid")"
		exit
	fi
	set_bg "$(<"$state.current")"
	# And for the login screen, in case it was made since that image was set
	share_bg "$(<"$state.current")"
	exit
fi

# --next cuts the wait short
echo $$ >"$state.pid"
trap 'kill "$sleeper" 2>/dev/null' USR1

last=
while :; do
	# Never the same image twice in a row
	img=$(find -L "$dir" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) |
		grep -vxF -- "$last" | shuf -n1)
	if [ -n "$img" ]; then
		set_bg "$img" || exit
		share_bg "$img"
		echo "$img" >"$state.current"
		last=$img
	fi
	# Without the lock, so a killed rotation can be started again right away.
	# In the background, so a --next signal is handled while it waits.
	sleep "$interval" 9>&- &
	sleeper=$!
	wait "$sleeper"
done
