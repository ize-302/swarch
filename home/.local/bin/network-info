#!/usr/bin/env python3
# ~/.local/bin/network-info
# What the launcher's control panel (~/.config/quickshell/launcher) can't get
# from Quickshell about Wi-Fi, done with nmcli:
#
#   network-info show <ssid>             details of a network, as JSON
#   network-info autoconnect <uuid> yes|no
#   network-info join <ssid>             join a hidden network; the password
#                                        (none for an open one) on stdin
#   network-info connect <ssid>          connect with the password on stdin,
#                                        a new network or a saved one whose
#                                        password changed
#
# join and connect print {"ok", "error"}. When NetworkManager runs Wi-Fi
# through iwd (`wifi.backend=iwd`), they give the password to iwd itself:
# iwd asks NetworkManager for a network's password only through a secret
# agent (nm-applet's dialog), which there isn't one of, so a password saved
# with nmcli alone never reaches it. Once iwd knows it, NetworkManager
# connects to that network by itself like any other.
#
# show prints {"ssid", "uuid", "autoconnect", "connected", "device",
# "security", "signal", "frequency", "rate", "ip", "gateway", "dns", "mac"};
# whatever isn't known (not saved, not in range, not connected) is left out.
import json
import re
import subprocess
import sys


def nmcli(*args, stdin=None):
    result = subprocess.run(["nmcli", *args], capture_output=True, text=True, input=stdin)
    return result.returncode, result.stdout, result.stderr


def iwd_backend():
    """Whether iwd is what connects (it can't run beside wpa_supplicant)."""
    return subprocess.run(["systemctl", "is-active", "--quiet", "iwd"]).returncode == 0


def iwctl(device, password, *args):
    """An iwctl station command, given the password rather than asking."""
    command = ["iwctl", "--dont-ask"]
    if password:
        command += ["--passphrase", password]
    result = subprocess.run([*command, "station", device, *args], capture_output=True, text=True)
    # iwctl colours its messages
    error = re.sub(r"\x1b\[[0-9;]*m", "", result.stdout + result.stderr).strip()
    if result.returncode and error in ("Operation failed", "Operation aborted"):
        error = "Couldn't connect. Check the password."
    return result.returncode, error


def wifi_device():
    _, out, _ = nmcli("-t", "-f", "DEVICE,TYPE", "device")
    return next((fields(line)[0] for line in out.splitlines() if fields(line)[1] == "wifi"), None)


def report(code, error):
    print(json.dumps({"ok": code == 0, "error": "" if code == 0 else error.strip().removeprefix("Error: ") or "Couldn't connect"}))


def fields(line):
    """Splits nmcli's terse output on ':' but not on '\\:'."""
    parts, current, escaped = [], "", False
    for char in line:
        if escaped:
            current += char
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == ":":
            parts.append(current)
            current = ""
        else:
            current += char
    parts.append(current)
    return parts


def saved_connection(ssid):
    """The saved connection for an SSID: (uuid, autoconnect), or None."""
    _, out, _ = nmcli("-t", "-f", "UUID,TYPE,AUTOCONNECT", "connection", "show")
    for line in out.splitlines():
        uuid, kind, autoconnect = fields(line)[:3]
        if kind != "802-11-wireless":
            continue
        _, setting, _ = nmcli("-g", "802-11-wireless.ssid", "connection", "show", uuid)
        if setting.strip() == ssid:
            return uuid, autoconnect == "yes"
    return None


def show(ssid):
    info = {"ssid": ssid, "connected": False}

    saved = saved_connection(ssid)
    if saved:
        info["uuid"], info["autoconnect"] = saved

    # In range: signal, band and security from the last scan
    _, out, _ = nmcli("-t", "-f", "IN-USE,SSID,SIGNAL,FREQ,RATE,SECURITY,DEVICE", "device", "wifi", "list", "--rescan", "no")
    best = None
    for line in out.splitlines():
        in_use, name, signal, freq, rate, security, device = fields(line)[:7]
        if name != ssid:
            continue
        entry = (in_use == "*", int(signal or 0), freq, rate, security, device)
        if best is None or entry[:2] > best[:2]:
            best = entry
    if best:
        in_use, signal, freq, rate, security, device = best
        info.update(signal=signal, frequency=freq, rate=rate, security=security or "Open")
        if in_use:
            info.update(connected=True, device=device)

    # Connected: the addresses
    if info["connected"]:
        _, out, _ = nmcli("-t", "-f", "GENERAL.HWADDR,IP4.ADDRESS,IP4.GATEWAY,IP4.DNS", "device", "show", info["device"])
        dns = []
        for line in out.splitlines():
            key, _, value = line.partition(":")
            if key == "GENERAL.HWADDR":
                info["mac"] = value
            elif key.startswith("IP4.ADDRESS") and "ip" not in info:
                info["ip"] = value.split("/")[0]
            elif key == "IP4.GATEWAY" and value:
                info["gateway"] = value
            elif key.startswith("IP4.DNS"):
                dns.append(value)
        if dns:
            info["dns"] = dns

    print(json.dumps(info))


def autoconnect(uuid, value):
    code, _, err = nmcli("connection", "modify", uuid, "connection.autoconnect", value)
    if code:
        sys.exit(err.strip())


# nmcli and iwctl only take the password as an argument; it's on the
# command line (and in `ps`) for the moment connecting takes


def join(ssid):
    password = sys.stdin.readline().rstrip("\n")
    device = wifi_device()
    if device is None:
        sys.exit("No Wi-Fi device")
    if iwd_backend():
        report(*iwctl(device, password, "connect-hidden", ssid))
        return
    args = ["device", "wifi", "connect", ssid, "ifname", device, "hidden", "yes"]
    if password:
        args += ["password", password]
    code, _, err = nmcli(*args)
    report(code, err)


def connect(ssid):
    password = sys.stdin.readline().rstrip("\n")
    device = wifi_device()
    if device is None:
        sys.exit("No Wi-Fi device")
    saved = saved_connection(ssid)
    # The saved connection keeps the new password too, for nmcli
    if saved:
        code, _, err = nmcli("connection", "modify", saved[0], "802-11-wireless-security.psk", password)
        if code:
            report(code, err)
            return
    if iwd_backend():
        report(*iwctl(device, password, "connect", ssid))
    elif saved:
        code, _, err = nmcli("connection", "up", saved[0])
        report(code, err)
    else:
        code, _, err = nmcli("device", "wifi", "connect", ssid, "ifname", device, "password", password)
        report(code, err)


def main():
    command, rest = (sys.argv[1], sys.argv[2:]) if len(sys.argv) > 1 else ("", [])
    if command == "show" and len(rest) == 1:
        show(rest[0])
    elif command == "connect" and len(rest) == 1:
        connect(rest[0])
    elif command == "autoconnect" and len(rest) == 2 and rest[1] in ("yes", "no"):
        autoconnect(*rest)
    elif command == "join" and len(rest) == 1:
        join(rest[0])
    else:
        sys.exit(__doc__ or "usage: network-info show <ssid> | autoconnect <uuid> yes|no | join <ssid> | connect <ssid>")


if __name__ == "__main__":
    main()
