#!/bin/bash
# ~/.local/bin/record-toggle
# ~/.local/bin/record-toggle --sound|--desktop
# Records an area or a screen picked with slurp to ~/Videos, or stops the recording
# that's going. --sound records the microphone too, --desktop what's
# playing. The bar's red dot (custom/recording in config/waybar) shows while
# it records: waybar is signalled (SIGRTMIN+12) when it starts and stops.
bar() {
	pkill -RTMIN+12 -x waybar
}

if pgrep -x wf-recorder >/dev/null; then
	pkill -INT wf-recorder
	notify-send "Recording saved"
else
	audio_args=()
	case "$1" in
	-s | --sound)
		audio_args=(--audio)
		;;
	-d | --desktop)
		default_sink="$(pactl get-default-sink)"
		audio_args=(--audio="${default_sink}.monitor")
		;;
	esac

	notify-send "Select area to record"
	# Drag for an area, click for the whole screen under the mouse (-o);
	# Escape: nothing to record
	area=$(slurp -o) || exit 0
	wf-recorder -g "$area" -c libx264rgb "${audio_args[@]}" -f ~/Videos/rec-$(date +%Y%m%d-%H%M%S).mp4 &
	# Once wf-recorder is running, so the bar finds it
	sleep 0.3
	bar
	# Stopped (by running this again) or failed: the dot goes
	wait
	bar
fi
