#!/bin/bash
# ~/.local/bin/control-panel [--pointer] [section]
# Toggles the Quickshell sound popup (~/.config/quickshell/launcher), or
# with a section ("Network", "Bluetooth", ...) opens that page on its own,
# starting its daemon first if it isn't running. --pointer (from the bar's
# modules) centres it over the module under the pointer, rather than at the
# right edge.
at=""
if [ "$1" = "--pointer" ]; then
	at="AtPointer"
	shift
fi
if [ -n "$1" ]; then
	toggle=(qs -c launcher ipc call controlPanel "openSection$at" "$1")
else
	toggle=(qs -c launcher ipc call controlPanel "toggleControlPanel$at")
fi

"${toggle[@]}" >/dev/null 2>&1 && exit 0

# Not running yet: start it and wait for it to answer
if qs -c launcher -d >/dev/null 2>&1; then
	for _ in {1..20}; do
		"${toggle[@]}" >/dev/null 2>&1 && exit 0
		sleep 0.1
	done
fi

exit 1
