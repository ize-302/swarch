#!/bin/bash
# ~/.local/bin/notification-center [--pointer]
# Toggles the Quickshell notification centre (~/.config/quickshell/launcher),
# starting its daemon first if it isn't running. --pointer (from the bar's
# bell) centres it over the bell, rather than at the right edge.
if [ "$1" = "--pointer" ]; then
	toggle=(qs -c launcher ipc call notificationCenter toggleNotificationCenterAtPointer)
else
	toggle=(qs -c launcher ipc call notificationCenter toggleNotificationCenter)
fi

"${toggle[@]}" >/dev/null 2>&1 && exit 0

# Not running yet: start it and wait for it to answer
if qs -c launcher -d >/dev/null 2>&1; then
	for _ in {1..20}; do
		"${toggle[@]}" >/dev/null 2>&1 && exit 0
		sleep 0.1
	done
fi

exit 1
