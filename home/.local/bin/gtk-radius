#!/usr/bin/env python3
# ~/.local/bin/gtk-radius
# Writes ~/.config/gtk-3.0/radius.css: adw-gtk3's corner radii brought down
# to the launcher's 4px (cornerRadius in config/quickshell/launcher/Theme.qml).
# Rerun after an adw-gtk-theme update.
#
# Every rule of the theme that sets a radius is copied, its 0s and circles
# kept too: gtk.css outranks the theme whatever the selector, so a 4px on a
# broad selector would otherwise beat the theme's 0 on a narrower one.
import os
import re
import sys

THEME = "/usr/share/themes/adw-gtk3-dark/gtk-3.0/gtk.css"
OUT = os.path.expanduser("~/.config/gtk-3.0/radius.css")
RADIUS = 4

# Above this the radius makes a circle or a pill, which stays
PILL = 99


def shrink(value):
    def length(match):
        px = float(match.group(1))
        return f"{RADIUS}px" if RADIUS < px < PILL else match.group(0)

    return re.sub(r"(\d+(?:\.\d+)?)px", length, value)


css = re.sub(r"/\*.*?\*/", "", open(THEME).read(), flags=re.S)
rules = []
for selector, body in re.findall(r"([^{}]+)\{([^{}]*)\}", css):
    radii = re.findall(r"(border(?:-[a-z]+)?-radius)\s*:\s*([^;]+);", body)
    if radii:
        lines = "".join(f"  {name}: {shrink(value.strip())};\n" for name, value in radii)
        rules.append(f"{' '.join(selector.split())} {{\n{lines}}}\n")

with open(OUT, "w") as out:
    out.write(f"/* Generated by ~/.local/bin/gtk-radius from {THEME} */\n\n")
    out.write("\n".join(rules))
print(f"{len(rules)} rules written to {OUT}", file=sys.stderr)
